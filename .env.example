# Copy to .env (gitignored). Never commit real values.
ANTHROPIC_API_KEY=          # Claude API
SARVAM_API_KEY=             # Sarvam speech (header api-subscription-key): the fallback provider
# Bodhan AI speech (1 Nov 2026, docs/build/reports/SPEECH-LAYER.md): the first provider. Two keys, one per model; each
# falls back to BODHAN_API_KEY when unset. Never paste a key anywhere but .env.
BODHAN_SPEAK_API_KEY=       # text to speech (indic-speak)
BODHAN_TRANSCRIBE_API_KEY=  # speech to text (indic-transcribe)
BODHAN_API_KEY=             # optional: one key for both
BODHAN_BASE_URL=            # default https://api.bodhan.ai
BODHAN_CONNECT_TIMEOUT_S=   # default 5
BODHAN_STT_TIMEOUT_S=       # default 20 (read timeout)
BODHAN_TTS_TIMEOUT_S=       # default 30 (read timeout)
BODHAN_TTS_MAX_CHARS=       # default 300: longer text is refused so callers split it into sentences first
SPEECH_TTS_PROVIDERS=bodhan,sarvam  # order to try; a provider with no key is skipped
SPEECH_STT_PROVIDERS=bodhan,sarvam
# SPEECH_TTS_PROVIDERS_TA=sarvam,bodhan   # optional per-language override (EN, HI, TA)
SPEECH_SESSION_MAX_STT_SECONDS=600  # per practice session; over it, voice is off and the text continues
SPEECH_SESSION_MAX_TTS_CHARS=6000
BODHAN_REQUESTS_PER_MINUTE=8 # measured 1 Nov: Bodhan's default limit per model; requests are paced to it
BODHAN_PACE_MAX_WAIT_S=90    # a call that would wait longer fails at once (the chain falls back to Sarvam)
BODHAN_LIVE_PACE_MAX_WAIT_S=2 # the same for a live Practice Class turn: a teacher is waiting
SPEECH_SHADOW_PROVIDER=       # off by default; e.g. bodhan: also send Practice speech to it and log only a similarity score and latency
SPEECH_SHADOW_PER_MINUTE=4    # at most this many shadow transcriptions a minute (each counts in the session's speech allowance)
BODHAN_MAX_RETRY_AFTER_S=60  # longest Retry-After honoured before the one retry
BODHAN_RATE_BACKOFF_S=8      # wait after a 429 that has no Retry-After
# Lesson audio (services/speech/lessons.py)
LESSON_MP3_KBPS=48            # MP3 mono bit rate (decided 1 Nov; breaks the 10 MB track budget at the lesson cap)
LESSON_CHUNK_TARGET_CHARS=220 # one or two sentences per request (calibration: ~11 chars/s, 28 s is ~300 chars)
LESSON_CHUNK_MAX_CHARS=300
LESSON_SENTENCE_GAP_MS=250
LESSON_SECTION_GAP_MS=500
LESSON_ROUNDTRIP_MAX_CER=0.25 # a chunk heard back worse than this is made once more, then flagged
LESSON_TTS_CONCURRENCY=3
SPEECH_MODE=live            # live | stub (scripted transcripts and a tone, no network)
SPEECH_BUDGET_INR_DAILY=200  # speech hard stop per day (in-memory, per process); voice then falls back to text
SARVAM_CLONES=              # 1 turns on cloned child voices (beta, off by default)
SARVAM_DICT_HI=             # pronunciation dictionary ids (Bulbul v3), one per language
SARVAM_DICT_TA=
SARVAM_DICT_EN=
TELEGRAM_BOT_TOKEN=         # from @BotFather
LINK_SECRET=                # signs bot-to-web links; set it so links survive a restart
TELEGRAM_WEBHOOK_SECRET=    # random string, checked on webhook calls
DATABASE_URL=sqlite:///./dev.sqlite   # Postgres URL in production
S3_ENDPOINT=                # S3-compatible endpoint (published audio only)
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
PUBLIC_BASE_URL=http://localhost:8000
PWA_ORIGIN=http://localhost:5173
AI_BUDGET_USD_TOTAL=350     # hard stop for non-judge traffic
AI_BUDGET_USD_DAILY=40
# Model ids: confirm on Anthropic's model pages; defaults live in ai/config.py
MODEL_CHILD=claude-sonnet-5-5
MODEL_LABEL=claude-haiku-5-5
MODEL_FEEDBACK=claude-sonnet-5-5
MODEL_METHOD=claude-sonnet-5-5
MODEL_DRAFT=claude-opus-5-5
MODEL_DIGEST=claude-haiku-5-5
MODEL_POINTER=claude-haiku-5-5   # call 9, built in P10
MODEL_DEMO_TEACHER=claude-haiku-5-5   # call 10, judge mode only
MODEL_SPRITE=claude-sonnet-5-5   # call 11, sprite item authoring, offline only
MODEL_FEEDBACK_REVIEW=claude-haiku-5-5   # call 17, read a note about a module (tags and follow-ups)
MODEL_NARRATION=claude-haiku-5-5   # call 18, word an approved module so a listener can follow it
MODEL_CHAT_CLASS=claude-haiku-5-5   # call 12, class of a teacher's question to her mentor
MODEL_CHAT=claude-sonnet-5-5   # call 13, draft of a reply from approved material
MODEL_ASSIST=claude-sonnet-5-5   # call 14, the role-scoped assistant answer
MODEL_CHECK=claude-haiku-5-5
MODEL_PAPER_READ=claude-haiku-5-5   # call 16, Papers page: read the printed questions of a paper
MODEL_SCAN=claude-haiku-5-5       # call 15, pilot sheet ingest (header and name scan), offline
MODEL_READ=claude-haiku-5-5
MODEL_READ_RETRY=claude-sonnet-5-5
AI_MODE=recorded            # recorded | live | record | stub (rule-based, offline demos) | off (every call fails as if unreachable)
LOG_LEVEL=INFO
AI_BUDGET_USD_HARD=500      # ceiling that also stops judge-mode traffic

JUDGE_MODE=0                 # 1 on the public demo only; unset or 0 = a role cannot be chosen, no demo teacher
ADMIN_KEY=                  # required in any real deployment: protects /api/admin/*
ADMIN_OPEN=                 # 1 opens the admin page when no key is set (local dev and the judge demo only)
# ---- The pilot class's sheets in Enter check (docs/pilot/PILOT-DEMO.md). Local machine only, never hosted
PILOT_DEMO=0                # 1 = offer the pilot class's sheets in Enter check (needs the folder, a consent note and the answer file)
PILOT_DEMO_DIR=             # the pilot folder; empty means data/pilot (git-ignored)

# ---- Lesson audio storage ---------------------------------------------------------------
AUDIO_FORMAT=mp3            # m4a (AAC) or mp3; mono, 32 kbps
MEDIA_LOCAL_STORE=          # 1 = keep lesson audio in .media-local/ instead of a bucket (local dev only, never in production)
GCS_AUDIO_BUCKET=           # Google Cloud Storage: the bucket for approved lesson audio (use this OR the S3 keys)
# Google credentials: leave ALL of these blank to use Application Default Credentials. On GCP (Cloud Run,
# Compute Engine) that is the attached service account; on a laptop run `gcloud auth application-default login`.
# URLs are then signed by Google's IAM service, so the signing service account needs "Service Account Token
# Creator" granted to the caller (on GCP, to itself).
GCS_SIGNER_SERVICE_ACCOUNT= # laptop only: the service account that signs URLs, e.g. gcs-storage-admin@PROJECT.iam.gserviceaccount.com
GCS_CREDENTIALS_JSON=       # only if your organisation allows keys: the key JSON on one line
GOOGLE_APPLICATION_CREDENTIALS=  # or a path to the key file
# Kept answer sheets (only for a teacher who agreed): a PRIVATE bucket, uniform access, public access prevention on.
GCS_SHEETS_BUCKET=          # the bucket for approved answer-sheet pictures; blank = sheets are not kept
SHEET_RETENTION_DAYS=60     # days a sheet is kept after the teacher approves it, then deleted (never earlier)
SHEETS_LOCAL_STORE=         # 1 = keep sheets in .media-local/sheets instead of a bucket (local dev and tests only)
# Per-connection request limits per minute for the endpoints that cost money (0 = off).
# Defaults: practice_session 20, practice_turn 40, practice_voice 12, practice_watch 6, sheets_read 30
RATE_LIMIT_PRACTICE_SESSION_PER_MIN=
RATE_LIMIT_PRACTICE_TURN_PER_MIN=
RATE_LIMIT_PRACTICE_VOICE_PER_MIN=
RATE_LIMIT_PRACTICE_WATCH_PER_MIN=
RATE_LIMIT_SHEETS_READ_PER_MIN=
AUDIT_HASH_SALT=            # any long random string: keys the audit log's input hashes

# Tester stats (public demo and tester links only). Opt-in, coarse data, see README "Tester stats".
TESTER_STATS=               # 1 = turn on tester profiles, usage events, the Feedback button and the judge's Testing evidence view
TESTER_SALT=                # fixed app salt mixed into the on-device device hash (default cc-tester-v1)
TESTER_TEAM_TOKEN=          # secret for the team export and for tagging team devices with ?team=<token>; leave empty to switch both off
TESTER_RETENTION_DAYS=      # delete tester events and feedback after this many days (default 90)

# Assistant: meaning-based retrieval (off by default; see scripts/embed_assistant_index.py)
RETRIEVAL=off                 # off | vector
GEMINI_API_KEY=               # Google AI Studio key, used for embeddings only
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIMS=768
VECTOR_STORE=local            # local (services/assistant/index/vectors.npz) | firestore
FIRESTORE_PROJECT=            # only for VECTOR_STORE=firestore; uses Application Default Credentials

# Testing shortcuts on a developer's machine (1 Nov 2026): Approve all entered in Enter check. Never on a public
# deployment.
DEV_TESTING=0                 # 1 = show the shortcuts

# Practice Class speed (31 Oct 2026). Both are off by default: every child line is written by call 1 and
# checked by call 7. See docs/build/DECISIONS.md (2026-10-31) before turning them on in a public deployment.
PRACTICE_SKIP_CHECKER=0       # 1 = a child's line skips call 7 (the code checks and pre-filter still run)
PRACTICE_AI_INTENTS=all       # all | a list such as explain,work_aloud: any other kind of line is the engine's template

# Practice Class child model (docs/BAYESIAN-MODEL.md). legacy (the default when unset) is the rule-based simulator:
# a move lowers error strength by its fixed effect. bayesian is the 32-state model (engine/bayes/): place value x the
# exchange idea x the written step x the wrong habit, with an observer that updates a belief by Bayes' rule. Any other
# value stops the API at startup. A session keeps the model it started with.
SIMULATOR_MODEL=legacy        # legacy | bayesian
# Bayesian model only: the parameter file, loaded and checked at startup in bayesian mode. Blank = the build defaults
# in content/bayes/params.v1.yaml (not reviewed by an educator, not fitted to real children).
BAYES_PARAMS=
