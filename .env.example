# Copy to .env (gitignored). Never commit real values.
ANTHROPIC_API_KEY=          # Claude API
SARVAM_API_KEY=             # Sarvam speech (header api-subscription-key)
SPEECH_MODE=live            # live | stub (scripted transcripts and a tone, no network)
SPEECH_BUDGET_INR_DAILY=200  # speech hard stop per day (in-memory, per process); voice then falls back to text
SARVAM_CLONES=              # 1 turns on cloned child voices (beta, off by default)
SARVAM_DICT_HI=             # pronunciation dictionary ids (Bulbul v3), one per language
SARVAM_DICT_TA=
SARVAM_DICT_EN=
TELEGRAM_BOT_TOKEN=         # from @BotFather
LINK_SECRET=                # signs bot-to-web links; set it so links survive a restart
TELEGRAM_WEBHOOK_SECRET=    # random string, checked on webhook calls
DATABASE_URL=sqlite:///./dev.sqlite   # Postgres URL in production
S3_ENDPOINT=                # S3-compatible endpoint (published audio only)
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
PUBLIC_BASE_URL=http://localhost:8000
PWA_ORIGIN=http://localhost:5173
AI_BUDGET_USD_TOTAL=350     # hard stop for non-judge traffic
AI_BUDGET_USD_DAILY=40
# Model ids: confirm on Anthropic's model pages; defaults live in ai/config.py
MODEL_CHILD=claude-sonnet-5-5
MODEL_LABEL=claude-haiku-5-5
MODEL_FEEDBACK=claude-sonnet-5-5
MODEL_METHOD=claude-sonnet-5-5
MODEL_DRAFT=claude-opus-5-5
MODEL_DIGEST=claude-haiku-5-5
MODEL_POINTER=claude-haiku-5-5   # call 9, built in P10
MODEL_DEMO_TEACHER=claude-haiku-5-5   # call 10, judge mode only
MODEL_SPRITE=claude-sonnet-5-5   # call 11, sprite item authoring, offline only
MODEL_CHAT_CLASS=claude-haiku-5-5   # call 12, class of a teacher's question to her mentor
MODEL_CHAT=claude-sonnet-5-5   # call 13, draft of a reply from approved material
MODEL_ASSIST=claude-sonnet-5-5   # call 14, the role-scoped assistant answer
MODEL_CHECK=claude-haiku-5-5
MODEL_READ=claude-haiku-5-5
MODEL_READ_RETRY=claude-sonnet-5-5
AI_MODE=recorded            # recorded | live | record | stub (rule-based, offline demos)
LOG_LEVEL=INFO
AI_BUDGET_USD_HARD=500      # ceiling that also stops judge-mode traffic

JUDGE_MODE=0                 # 1 on the public demo only; unset or 0 = a role cannot be chosen, no demo teacher
ADMIN_KEY=                  # required in any real deployment: protects /api/admin/*
ADMIN_OPEN=                 # 1 opens the admin page when no key is set (local dev and the judge demo only)
# ---- Pilot mode (docs/build/reports/PILOT-MODE.md) -------------------------------------------
PILOT_MODE=0                # 1 = sign-in, Upload sheets and Intervention audio only; everything else is a 404
PILOT_ACCOUNTS=             # name:roles:key, comma separated, e.g. seema:coordinator+coach:KEY,ops:coordinator:KEY2 (roles: coordinator, coach, officer)
PILOT_TOKEN_SECRET=         # signs sign-in tokens (falls back to LINK_SECRET); sign-in is off without one
PILOT_AUDIO_MAX=10          # most audio files the coordinator may ask for
PILOT_RETENTION_DAYS=90     # default days to keep sheet photos; the coordinator can change it in the app
PILOT_VOICE_DAILY_MAX=20    # most new audio files that teachers' taps on a lesson link may make per day (speech credit guard)
PILOT_AUDIO_FORMAT=mp3      # m4a (AAC) or mp3; mono, 32 kbps
PILOT_LOCAL_STORE=          # 1 = keep sheets and audio in .pilot-local/ instead of S3 (local dev only, never in production)
GCS_SHEETS_BUCKET=          # Google Cloud Storage / Firebase Storage: a private bucket for sheet photos (use this OR the S3 keys)
GCS_AUDIO_BUCKET=           # a second bucket, different from GCS_SHEETS_BUCKET, for approved audio
# Google credentials: leave ALL of these blank to use Application Default Credentials. On GCP (Cloud Run,
# Compute Engine) that is the attached service account; on a laptop run `gcloud auth application-default login`.
# URLs are then signed by Google's IAM service, so the signing service account needs "Service Account Token
# Creator" granted to the caller (on GCP, to itself).
GCS_SIGNER_SERVICE_ACCOUNT= # laptop only: the service account that signs URLs, e.g. gcs-storage-admin@PROJECT.iam.gserviceaccount.com
GCS_CREDENTIALS_JSON=       # only if your organisation allows keys: the key JSON on one line
GOOGLE_APPLICATION_CREDENTIALS=  # or a path to the key file
S3_SHEETS_BUCKET=           # a private bucket, different from S3_BUCKET (published audio); server-side encryption, no public access
S3_SHEETS_REGION=
S3_SHEETS_ACCESS_KEY_ID=    # falls back to S3_ACCESS_KEY_ID; a separate key limited to this bucket is better
S3_SHEETS_SECRET_ACCESS_KEY=
VITE_PILOT_MODE=            # PWA build flag: 1 builds the pilot app (the app also asks /api/health)
# Per-connection request limits per minute for the endpoints that cost money (0 = off).
# Defaults: practice_session 20, practice_turn 40, practice_voice 12, practice_watch 6, sheets_read 30
RATE_LIMIT_PRACTICE_SESSION_PER_MIN=
RATE_LIMIT_PRACTICE_TURN_PER_MIN=
RATE_LIMIT_PRACTICE_VOICE_PER_MIN=
RATE_LIMIT_PRACTICE_WATCH_PER_MIN=
RATE_LIMIT_SHEETS_READ_PER_MIN=
AUDIT_HASH_SALT=            # any long random string: keys the audit log's input hashes
