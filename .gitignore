# service-account keys (never commit)
gcp/*.json
*-key.json

# runtime rejection examples waiting for the coach (never commit)
content/rejections/pending/

# Demo Studio: the cache of synthetic demo sheets and the first demo lesson (made on demand)
data/demo_cache/

# Stitch pack: pictures and raw element data are rebuilt by `python tasks.py stitch-pack` (about 80 MB);
# the manifest, specs, prompts, index and README stay tracked.
docs/design/stitch/pack/*/*.png
docs/design/stitch/pack/*/*.json
docs/design/stitch/pack/capture-index.json
tools/stitch_pack/.work/

# Papers page: uploads kept for review at most 24 hours (never commit)
